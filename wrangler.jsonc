{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurea-perfumes",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/oauth/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurea-perfumes-db",
      "database_id": "252e71d5-e5df-45a1-87f3-5a68426f963c"
    }
  ]
}
