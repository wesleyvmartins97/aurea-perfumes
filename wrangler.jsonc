{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurea-perfumes",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-28",
  // Preserva variáveis e secrets configurados no painel da Cloudflare em futuros deploys.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/oauth/*",
      "/admin",
      "/admin/*",
      "/merchant-feed.xml",
      "/google-merchant.xml",
      "/sitemap.xml",
      "/perfume/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurea-perfumes-db",
      "database_id": "252e71d5-e5df-45a1-87f3-5a68426f963c"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "MERCADOPAGO_MODE": "production",
    "ADMIN_EMAILS": "wesleyvmartins97@gmail.com,jjessitrindade@gmail.com",
    "ADMIN_USERNAME": "wesleymartins",
    // Valores não secretos necessários em produção. Segredos continuam somente no painel da Cloudflare.
    "ENVIOECOM_ORIGIN_CEP": "29703131",
    "GA4_MEASUREMENT_ID": "G-B3B09R32V6",
    "META_PIXEL_ID": "1341440512390842",
    "META_TEST_EVENT_CODE": "",
    "DAILY_REPORT_HOUR": "20"
  }
}
